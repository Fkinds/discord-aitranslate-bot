# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Google Gemini API Configuration
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Translator: gemini (default) or fake
# fake posts a placeholder instead of a translation and needs no
# GOOGLE_GEMINI_API_KEY, for trying the bot out without the API.
TRANSLATOR=gemini

# Translation Configuration
DEFAULT_TARGET_LANGUAGE=ja
# One language tag, such as ja, or two separated by a comma, such as ja,ko, to
# translate between them: what is said in one is translated into the other.
# Offered in the commands: ja, en, ko, zh, es, fr, de, it, pt, ru.

# Bot Configuration
LOG_LEVEL=info
# Options: error, warn, info, debug

# Optional: Gemini Model Configuration
GEMINI_MODEL=gemini-3.8-flash
# Model to use for translation; it must take audio. gemini-3.8-flash when unset.
# https://aistudio.google.com/docs/models
