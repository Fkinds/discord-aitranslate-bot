# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Google Gemini API Configuration
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Translator: gemini (default) or fake
# fake posts a placeholder instead of a translation and needs no
# GOOGLE_GEMINI_API_KEY, for trying the bot out without the API.
TRANSLATOR=gemini

# Translation Configuration
DEFAULT_TARGET_LANGUAGE=ja
# Supported languages: ja (Japanese), en (English), ko (Korean), zh (Chinese), etc.

# Bot Configuration
LOG_LEVEL=info
# Options: error, warn, info, debug

# Optional: Gemini Model Configuration
GEMINI_MODEL=gemini-2.0-flash-exp
# Model to use for translation
