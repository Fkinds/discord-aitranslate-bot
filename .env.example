# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Translator: claude (default), local, gemini or fake
#   claude  transcribes on this machine with Whisper, and sends the text to
#           Anthropic's Claude (Claude Haiku 5.5) to be translated; needs
#           ANTHROPIC_API_KEY. Run pnpm models:download once first.
#   local   transcribes and translates on this machine, sending nothing anywhere.
#           Run pnpm models:download once first, for the models (2.2 GB).
#   gemini  sends what is said to Google Gemini; needs GOOGLE_GEMINI_API_KEY.
#   fake    posts a placeholder instead of a translation and sends nothing
#           anywhere, for trying the bot out.
TRANSLATOR=claude

# Anthropic API key (TRANSLATOR=claude), from https://platform.claude.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Where pnpm models:download puts the local models, and where the bot finds
# them. models/ in the working directory when unset.
# MODELS_DIR=models

# Translation Configuration
DEFAULT_TARGET_LANGUAGE=ja
# One language tag, such as ja, or two separated by a comma, such as ja,ko, to
# translate between them: what is said in one is translated into the other.
# Offered in the commands: ja, en, ko, zh, es, fr, de, it, pt, ru. Claude and
# the local translator take only these; Gemini takes any language tag.

# Bot Configuration
LOG_LEVEL=info
# Options: error, warn, info, debug

# Google Gemini API Configuration (TRANSLATOR=gemini only)
# GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use; it must take audio. gemini-3.8-flash when unset.
# https://aistudio.google.com/docs/models
# GEMINI_MODEL=gemini-3.8-flash
