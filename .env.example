# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Translator: claude (default), gemini, translategemma or fake
#   claude          transcribes on this machine with Whisper, and sends the
#                   text to Anthropic's Claude (Claude Haiku 5.5) to be
#                   translated; needs a sign-in with ant auth login, or
#                   ANTHROPIC_API_KEY. Run pnpm models:download once first.
#   gemini          sends what is said to Google Gemini; needs
#                   GOOGLE_GEMINI_API_KEY.
#   translategemma  transcribes on this machine with Whisper, and translates
#                   the text with Google's TranslateGemma on Ollama, for free;
#                   needs Ollama (https://ollama.com/download). Run
#                   pnpm models:download once first, which also has Ollama
#                   pull the model.
#   fake            posts a placeholder instead of a translation and sends
#                   nothing anywhere, for trying the bot out.
TRANSLATOR=claude

# Anthropic API key (TRANSLATOR=claude), from https://platform.claude.com/settings/keys
# Leave it unset to call Claude with what the Anthropic SDK finds instead: the
# sign-in of ant auth login, or Workload Identity Federation. A key set here
# is used instead of those.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Where pnpm models:download puts the local models, and where the bot finds
# them. models/ in the working directory when unset.
# MODELS_DIR=models

# Where Ollama is (TRANSLATOR=translategemma), written as for Ollama itself:
# a host, a host and a port, or a URL. 127.0.0.1:11434 when unset.
# OLLAMA_HOST=127.0.0.1:11434

# The TranslateGemma model for Ollama to run (TRANSLATOR=translategemma):
# translategemma:4b (3.3 GB), translategemma:12b (8.1 GB, the default) or
# translategemma:27b (17 GB).
# TRANSLATEGEMMA_MODEL=translategemma:12b

# A glossary whose terms TranslateGemma translates as it says
# (TRANSLATOR=translategemma only): its two languages on the first line, then
# a term a line. glossaries/overwatch.tsv has those of Overwatch in Japanese
# and Korean. A relative path is taken from the working directory. None when
# unset.
# GLOSSARY_FILE=glossaries/overwatch.tsv

# Translation Configuration
DEFAULT_TARGET_LANGUAGE=ja
# One language tag, such as ja, or two separated by a comma, such as ja,ko, to
# translate between them: what is said in one is translated into the other.
# Offered in the commands: ja, en, ko, zh, es, fr, de, it, pt, ru. Claude and
# TranslateGemma take only these; Gemini takes any language tag.

# Bot Configuration
LOG_LEVEL=info
# Options: error, warn, info, debug

# Record one member's utterances as WAVE files, to measure how well the bot
# hears them (pnpm eval:speech). Set both, or neither. No one else is
# recorded; record only someone who has agreed to it. Keep the recordings
# outside the repository.
# RECORD_SPEECH_OF=your_discord_user_id
# RECORDINGS_DIR=/path/outside/the/repository

# Google Gemini API Configuration (TRANSLATOR=gemini only)
# GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use; it must take audio. gemini-3.8-flash when unset.
# https://aistudio.google.com/docs/models
# GEMINI_MODEL=gemini-3.8-flash
