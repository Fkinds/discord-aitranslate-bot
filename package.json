{
  "name": "discord-multilingual-translator",
  "version": "1.0.0",
  "description": "Discord bot that translates voice chat in real time, hearing it with Whisper and translating with Claude, or with Google Gemini, into one language or between a pair of languages",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node --max-old-space-size=256 dist/main.js",
    "dev": "ts-node --max-old-space-size=256 src/main.ts",
    "watch": "tsc -w",
    "deploy-commands": "ts-node src/deploy-commands.ts",
    "models:download": "ts-node src/download-models.ts",
    "eval:speech": "ts-node --files src/evaluate-speech.ts",
    "eval:translation": "ts-node --files src/evaluate-translation.ts",
    "test": "jest --selectProjects small",
    "test:small": "jest --selectProjects small",
    "test:medium": "jest --selectProjects medium --runInBand",
    "test:watch": "jest --watch --selectProjects small",
    "test:coverage": "jest --coverage --selectProjects small medium",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs",
    "prepare": "prek install"
  },
  "keywords": [
    "discord",
    "bot",
    "translation",
    "multilingual",
    "realtime",
    "voice-translation",
    "ai-translation",
    "gemini",
    "whisper",
    "claude",
    "anthropic",
    "speech-to-text",
    "language-detection",
    "i18n",
    "localization",
    "voice-chat",
    "discord-bot",
    "typescript",
    "japanese",
    "english",
    "korean",
    "chinese",
    "spanish",
    "french",
    "german"
  ],
  "author": "Fkinds",
  "contributors": [
    "Lifegence Corporation. (original author)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fkinds/discord-aitranslate-bot.git"
  },
  "bugs": {
    "url": "https://github.com/Fkinds/discord-aitranslate-bot/issues"
  },
  "homepage": "https://github.com/Fkinds/discord-aitranslate-bot#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "1.13.0",
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.0",
    "@google/genai": "3.6.1",
    "@snazzah/davey": "^0.2.0",
    "discord.js": "^14.24.2",
    "dotenv": "^18.0.10",
    "libsodium-wrappers": "^0.8.0",
    "sherpa-onnx-node": "2.0.3",
    "sodium-native": "^5.0.9",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@j178/prek": "0.5.11",
    "@jest/globals": "30.5.2",
    "@types/jest": "30.0.0",
    "@types/libsodium-wrappers": "0.8.2",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "dependency-cruiser": "18.9.0",
    "jest": "30.5.2",
    "jest-environment-node": "30.5.2",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.23.0"
}
